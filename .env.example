# Database — REQUIRED in production (no defaults)
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-this-to-a-secure-random-string
DATABASE_URL=postgres://crm_user:change-this-to-a-secure-random-string@localhost:5432/crm_db

# Redis — REQUIRED in production
REDIS_URL=redis://:change-this-to-a-secure-random-string@localhost:6379
REDIS_PASSWORD=change-this-to-a-secure-random-string

# JWT - REQUIRED (generate: openssl rand -base64 48, min 32 chars, must differ)
JWT_SECRET=change-this-to-a-secure-random-string-min-32-chars

# Refresh Token - REQUIRED (generate: openssl rand -base64 48, min 32 chars, must differ from JWT_SECRET)
REFRESH_TOKEN_SECRET=change-this-to-a-different-secure-random-string

# Token encryption key for at-rest encryption (generate: openssl rand -base64 32)
# REQUIRED — backend refuses to start in production without it; without it
# OAuth/WhatsApp tokens are stored in PLAINTEXT (dev only)
TOKEN_ENCRYPTION_KEY=change-this-to-output-of-openssl-rand-base64-32

# Runtime environment: development (default) or production
ENV=development

# Set to "true" in production behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false

# Access Token Expiry (minutes)
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh Token Expiry (days)
REFRESH_TOKEN_EXPIRY_DAYS=30

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
RUST_LOG=info

# Reverse-proxy hops trusted for client IP extraction (nginx = 1, direct = 0)
TRUSTED_PROXY_HOPS=1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backup
BACKUP_DIR=./backups
# Optional passphrase for encrypted backups (scripts/backup-db.sh). If empty, backups are unencrypted.
# BACKUP_ENCRYPTION_PASSWORD=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-this
SMTP_FROM=noreply@example.com

# Frontend URL (for OAuth redirect back)
FRONTEND_URL=http://localhost:3000

# OAuth / Social Login (optional — uncomment to enable)
# Create OAuth app credentials at each provider's developer console.
# The callback URL format is: {FRONTEND_URL}/api/v1/auth/oauth/{provider}/callback
# Example: http://localhost:3000/api/v1/auth/oauth/google/callback

# Google OAuth 2.0
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft (Entra ID / Outlook) OAuth 2.0
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# WhatsApp Cloud API webhook verification (REQUIRED for secure inbound webhooks)
# Meta App Secret used to validate X-Hub-Signature-256 on incoming messages.
# If unset, the backend rejects all WhatsApp webhooks (unverified = untrusted).
# Find it in the Meta App Dashboard > WhatsApp > Configuration.
WHATSAPP_APP_SECRET=

# ─── Database-stored config (configured via Settings UI) ───
# WhatsApp Business API → Settings > Integraciones > WhatsApp
# AI provider (Ollama/OpenAI/Anthropic) → Settings > Integraciones > Inteligencia Artificial
# Lead assignment rules → Settings > Integraciones > Asignación de leads
# Branding → Admin > Branding
# Pipelines & stages → Admin > Embudos
# Profiles & permissions → Admin > Perfiles
# ─────────────────────────────────────────────────────────────

# Monitoring (compose uses GF_SECURITY_ADMIN_USER/PASSWORD)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-secure-random-string
