# Database
DATABASE_URL=postgres://crm_user:crm_password@localhost:5432/crm_db
# REQUIRED by docker-compose.yml (generate: openssl rand -base64 24)
POSTGRES_PASSWORD=change-this-to-a-secure-random-string

# Redis (compose builds REDIS_URL from REDIS_PASSWORD; set it explicitly in prod)
# REDIS_URL=redis://:<password>@localhost:6379
REDIS_PASSWORD=change-this-to-a-secure-random-string

# JWT - REQUIRED (generate: openssl rand -base64 48)
JWT_SECRET=change-this-to-a-secure-random-string

# Refresh Token - REQUIRED (generate: openssl rand -base64 48)
REFRESH_TOKEN_SECRET=change-this-to-a-secure-random-string

# Token encryption key for at-rest encryption (generate: openssl rand -base64 32)
# WARNING: if not set, integration tokens are stored in PLAINTEXT (dev only).
# In prod, set the key AND REQUIRE_ENCRYPTION=true (backend refuses to boot without it).
# TOKEN_ENCRYPTION_KEY=
REQUIRE_ENCRYPTION=false

# Bearer token gating /metrics (optional; unset = publicly scrapable, warned at boot)
# METRICS_TOKEN=

# Access Token Expiry (minutes)
ACCESS_TOKEN_EXPIRY_MINUTES=15

# Refresh Token Expiry (days)
REFRESH_TOKEN_EXPIRY_DAYS=30

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backup
BACKUP_DIR=./backups
# Optional GPG symmetric encryption for backup-db.sh (generate: openssl rand -base64 24)
# BACKUP_ENCRYPTION_PASSWORD=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=change-this
SMTP_FROM=noreply@example.com

# Frontend URL (for OAuth redirect back)
FRONTEND_URL=http://localhost:3000

# Publicly reachable base URL of the backend (used as OAuth redirect_uri
# target for calendar callbacks). Must be reachable from users' browsers.
BACKEND_PUBLIC_URL=http://localhost:8000

# Auth cookie policy (optional overrides)
# COOKIE_SAMESITE=Lax (Strict breaks split frontend/API domains; None forces Secure)
# COOKIE_SECURE defaults to true when BACKEND_PUBLIC_URL is https
# COOKIE_SAMESITE=
# COOKIE_SECURE=

# OAuth / Social Login (optional — uncomment to enable)
# Create OAuth app credentials at each provider's developer console.
# Register TWO callback URLs at the provider:
#   backend flow:      {BACKEND_PUBLIC_URL}/api/v1/integrations/{provider}/callback
#   calendar flow:     {BACKEND_PUBLIC_URL}/api/v1/calendar/{provider}/callback
# Example: http://localhost:8000/api/v1/integrations/google/callback

# Google OAuth 2.0
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft (Entra ID / Outlook) OAuth 2.0
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=

# GitHub OAuth (optional)
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=

# WhatsApp Cloud API webhook verification (REQUIRED for secure inbound webhooks)
# Meta App Secret used to validate X-Hub-Signature-256 on incoming messages.
# If unset, the backend rejects all WhatsApp webhooks (unverified = untrusted).
# Find it in the Meta App Dashboard > WhatsApp > Configuration.
WHATSAPP_APP_SECRET=

# ─── Database-stored config (configured via Settings UI) ───
# WhatsApp Business API → Settings > Integraciones > WhatsApp
# AI provider (Ollama/OpenAI/Anthropic) → Settings > Integraciones > Inteligencia Artificial
# Lead assignment rules → Settings > Integraciones > Asignación de leads
# Branding → Admin > Branding
# Pipelines & stages → Admin > Embudos
# Profiles & permissions → Admin > Perfiles
# ─────────────────────────────────────────────────────────────

# Monitoring (compose uses GF_SECURITY_ADMIN_USER/PASSWORD)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-to-a-secure-random-string
